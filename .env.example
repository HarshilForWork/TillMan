# TillHand — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not.
# Every value below is obtained by hand; see the tickets referenced per block.

# ─────────────────────────────────────────────────────────────────────────
# Prompt Guard — injection screening                      (start this FIRST)
# ─────────────────────────────────────────────────────────────────────────
# The model is GATED: you must request access from Meta on Hugging Face and
# wait for manual approval. Nothing else blocks on it, so request it on day
# one. Licence is the Llama 4 Community License (not MIT), with an
# EU-domicile carve-out. 512-token context — long catalog copy must be
# chunked. huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M
HF_TOKEN=
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M

# ─────────────────────────────────────────────────────────────────────────
# Razorpay — test mode only, no real money moves                      (#2)
# ─────────────────────────────────────────────────────────────────────────
# Key id starts rzp_test_. Constraints that bite:
#   - 30 payment links per business in test mode, EVER
#   - UPI payment links unavailable in test mode
#   - payment links are browser-only; no headless completion
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret is NOT the API key secret. Signature is HMAC-SHA256 over the
# RAW body. Needs a public URL, so set this after Railway is up.
# ngrok is blacklisted by Razorpay — use zrok for local tunnelling.
# Test-mode webhook setup reportedly needs the default OTP 754081.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Neon Postgres + pgvector                                            (#3)
# ─────────────────────────────────────────────────────────────────────────
# Decide pooled vs direct connection string before wiring the app — Neon
# pauses idle compute, so the first query after a quiet period is slow.
# Enable the extension once:  CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# Railway — deployment                                                (#3)
# ─────────────────────────────────────────────────────────────────────────
# Two settings are mandatory in the app, not here, but noted so they aren't
# forgotten: TransportSecuritySettings(allowed_hosts=[...]) or every request
# returns 421, and the server must be stateless (no sticky sessions).
# torch must install from the CPU index or the image ships the CUDA stack.
RAILWAY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Models — client and eval only. NOTHING in the request path uses these.
# ─────────────────────────────────────────────────────────────────────────
# Gemini drives the demo chat client. The server must keep working without it.
GOOGLE_API_KEY=

# Groq judges the eval suite. DeepEval has no native Groq support — check the
# LiteLLM route before writing a DeepEvalBaseLLM subclass.
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Storefront + UCP                                                   (#15)
# ─────────────────────────────────────────────────────────────────────────
# The /.well-known/ucp profile must be served from the merchant's APEX
# domain, even though the MCP endpoint lives elsewhere. That split is how
# real merchants do it (bluetokaicoffee.com → *.myshopify.com).
STOREFRONT_DOMAIN=
APP_BASE_URL=

# Pin the spec version. 2026-08-25 made namespace authority binding a MUST:
# a capability whose schema host does not match its namespace is SILENTLY
# rejected. Our com.tillhand.* schemas must be hosted on a matching host.
UCP_VERSION=2026-08-25

# ─────────────────────────────────────────────────────────────────────────
# Fixed local defaults — no input needed
# ─────────────────────────────────────────────────────────────────────────
DEEPEVAL_TELEMETRY_OPT_OUT=1
